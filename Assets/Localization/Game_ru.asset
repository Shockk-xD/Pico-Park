  - m_Id: 1005
    m_Localized: "\u0418\u0433\u0440\u043e\u043a 1\nA / D \u2014 \u0445\u043e\u0434\u044c\u0431\u0430   W \u2014 \u043f\u0440\u044b\u0436\u043e\u043a\nE \u2014 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435   Q \u2014 \u0431\u0440\u043e\u0441\u0438\u0442\u044c \u043a\u043b\u044e\u0447\nF \u2014 \u0421\u0438\u0433\u043d\u0430\u043b\n\n\u0418\u0433\u0440\u043e\u043a 2\n\u2190 / \u2192 \u2014 \u0445\u043e\u0434\u044c\u0431\u0430   \u2191 \u2014 \u043f\u0440\u044b\u0436\u043e\u043a\n\u2193 \u2014 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435   \u041f\u0440\u0430\u0432\u044b\u0439 Ctrl \u2014 \u0431\u0440\u043e\u0441\u0438\u0442\u044c \u043a\u043b\u044e\u0447\n\u041f\u0440\u0430\u0432\u044b\u0439 Shift \u2014 \u0421\u0438\u0433\u043d\u0430\u043b"
    m_Metadata:
      m_Items: []
